#!/usr/bin/env bash
#MISE description="unpack the write_files of each rendered user-data into build/extracted/<vm>/ for linting"
#MISE depends=["render"]
set -euo pipefail
cd "$MISE_PROJECT_ROOT/rehearsal/utm"
rm -rf build/extracted
for vm in desk backend; do
    # --no-project: a throwaway environment, not the project venv, which the test task is using
    # at the same time (M1 deletes this task along with extract-files.py).
    uv run --quiet --no-project --python 3.13 --with pyyaml extract-files.py "build/$vm-seed/user-data" "build/extracted/$vm"
done
