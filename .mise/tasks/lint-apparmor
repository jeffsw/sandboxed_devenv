#!/usr/bin/env bash
#MISE description="apparmor_parser syntax check of the client profiles in the desk seed (Linux; skipped elsewhere unless REQUIRE_LINUX_VALIDATORS=1)"
#MISE depends=["extract"]
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
profile=rehearsal/utm/build/extracted/desk/etc/apparmor.d/jetbrains-client
if ! command -v apparmor_parser >/dev/null 2>&1; then
    if [ "${REQUIRE_LINUX_VALIDATORS:-0}" = "1" ]; then
        echo "lint-apparmor: apparmor_parser is not installed and REQUIRE_LINUX_VALIDATORS=1" >&2
        exit 1
    fi
    echo "lint-apparmor: skipped, apparmor_parser is not installed here (CI runs it)"
    exit 0
fi
# The profiles declare the AppArmor 5 abi (Ubuntu 26.04). On a host with an older
# parser the abi file is absent; the syntax is otherwise identical, so check with
# the newest abi the host has.
check=rehearsal/utm/build/extracted/desk/jetbrains-client.check
abi=$(for f in /etc/apparmor.d/abi/*; do [ -e "$f" ] && basename "$f"; done | sort -V | tail -1)
sed "s#abi <abi/5.0>,#abi <abi/${abi:-5.0}>,#" "$profile" > "$check"
sudo -n apparmor_parser --skip-kernel-load --skip-cache --base /etc/apparmor.d "$check" 2>&1 \
    || apparmor_parser --skip-kernel-load --skip-cache --base /etc/apparmor.d "$check"
echo "lint-apparmor: ok (abi ${abi:-5.0})"
