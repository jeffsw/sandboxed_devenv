#!/usr/bin/env bash
#MISE description="render every Mermaid block of the summary with the Mermaid CLI (a parse error fails the build)"
#MISE depends=["lint-doc"]
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
blocks=(build/mermaid/*.mmd)
for block in "${blocks[@]}"; do
    npx --yes @mermaid-js/mermaid-cli@12.0.0 \
        --quiet --input "$block" --output "${block%.mmd}.svg" \
        --puppeteerConfigFile ci/puppeteer-config.json
    echo "rendered $block"
done
echo "lint-mermaid: ok (${#blocks[@]} diagrams)"
