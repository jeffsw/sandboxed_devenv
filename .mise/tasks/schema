#!/usr/bin/env bash
#MISE description="cloud-init schema validation of every rendered user-data: the package's host and backend documents and the rig's seeds (Linux; skipped elsewhere unless REQUIRE_LINUX_VALIDATORS=1)"
#MISE depends=["render"]
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
if ! command -v cloud-init >/dev/null 2>&1; then
    if [ "${REQUIRE_LINUX_VALIDATORS:-0}" = "1" ]; then
        echo "schema: cloud-init is not installed and REQUIRE_LINUX_VALIDATORS=1" >&2
        exit 1
    fi
    echo "schema: skipped, cloud-init is not installed here (CI runs it)"
    exit 0
fi
documents=(
    build/host/cloudinit/user-data
    build/backend/cloudinit-image/user-data
    build/backend/cloudinit-project/user-data
    rehearsal/utm/build/desk-seed/user-data
    rehearsal/utm/build/backend-seed/user-data
)
for document in "${documents[@]}"; do
    # The schema check logs a harmless datasource warning when not run inside a cloud-init'd instance.
    cloud-init schema --config-file "$document" 2>&1 | grep -v 'WARNING' || true
    cloud-init schema --config-file "$document" >/dev/null 2>&1
done
# network-config has its own schema.
cloud-init schema --schema-type network-config --config-file build/backend/cloudinit/network-config 2>&1 | grep -v 'WARNING' || true
cloud-init schema --schema-type network-config --config-file build/backend/cloudinit/network-config >/dev/null 2>&1
echo "schema: ok (${#documents[@]} user-data documents and one network-config)"
