packages:
  - git
  - curl
  - ca-certificates
  - unzip
  - acl
  - build-essential
  - openjdk-21-jdk-headless
  - python3-venv
  - python3-pip
  # Everyday tools; language toolchains come per project from .mise.toml.
  - direnv
  - jq
  - ripgrep
  - fd-find
  - just
  - pkg-config
  - libssl-dev
  # GitHub CLI from GitHub's repository above, installed without credentials; how it
  # authenticates is undecided (summary, Open questions).
  - gh
  # Headless JetBrains backend still links these.
  - fontconfig
  - libfreetype6
  - libxext6
  - libxrender1
  - libxtst6
  - libxi6

ssh_pwauth: false
users:
  - name: dev
    gecos: Development user (the untrusted side)
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - @@GW_PUBKEY@@

write_files:
  - path: /etc/ssh/sshd_config.d/10-backend.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      AllowAgentForwarding no
      # Gateway deploys and talks over SFTP: Ubuntu's default "Subsystem sftp" stays.
  # The canary check (summary section 6), from rehearsal/canary.py.
  - path: /usr/local/bin/canary
    permissions: "0755"
    encoding: b64
    content: @@CANARY_B64@@
  # Claude Code settings. make-seed.sh puts a CLAUDE_CODE_OAUTH_TOKEN into the env
  # block when keys/claude_oauth_token exists on the host (minted there with
  # `claude setup-token`, see summary 4.4); without it Claude Code asks to log in.
  - path: /home/dev/.claude/settings.json
    owner: dev:dev
    permissions: "0600"
    defer: true
    encoding: b64
    content: @@CLAUDE_SETTINGS_B64@@
  - path: /home/dev/.ssh/config
    owner: dev:dev
    permissions: "0600"
    defer: true
    content: |
      Host github.com
          User git
          IdentityFile ~/.ssh/deploy_ed25519
          IdentitiesOnly yes
      # No agent, ever: the IDE backend offers git an agent socket that proxies
      # to the client, and OpenSSH asks any agent about the configured identity
      # even with IdentitiesOnly. That query alone makes the client show its
      # "Provide SSH Key Access" dialog (seen 9 October). The deploy key lives in
      # the file above; nothing in this VM may fetch keys from the client.
      Host *
          ForwardAgent no
          IdentityAgent none

runcmd:
  # Unpack the IntelliJ IDEA Ultimate backend under /opt, picking the tarball for this CPU.
  - |
    set -e
    case "$(uname -m)" in
      aarch64) url="https://download.jetbrains.com/idea/ideaIU-@@IDEA_VERSION@@-aarch64.tar.gz" ;;
      *)       url="https://download.jetbrains.com/idea/ideaIU-@@IDEA_VERSION@@.tar.gz" ;;
    esac
    mkdir --parents /opt/jetbrains/idea
    curl --fail --silent --show-error --location "$url" \
      | tar --extract --gzip --strip-components=1 --directory=/opt/jetbrains/idea
    chown --recursive dev:dev /opt/jetbrains
  # Make the pre-installed backend visible to Gateway (route 2 in 4.4). Runs as
  # dev with dev's home, since the registration lives under ~/.cache.
  - sudo --user=dev --set-home /opt/jetbrains/idea/bin/remote-dev-server.sh registerBackendLocationForGateway
  # The Claude Code plugin into the backend now, so no install from the client and
  # no backend restart is needed later (summary 4.4). Needs Marketplace egress.
  - sudo --user=dev --set-home /opt/jetbrains/idea/bin/remote-dev-server.sh installPlugins /home/dev com.anthropic.code.plugin || true
  # Per-VM deploy key: ed25519, no passphrase (-N ""), comment (-C), file (-f).
  # ssh-keygen has no long options. Register the public key from the host with:
  #   gh repo deploy-key add <file> --repo owner/repo --title backend-vm [--allow-write]
  - sudo --user=dev --set-home ssh-keygen -q -t ed25519 -N "" -C deploy@backend -f /home/dev/.ssh/deploy_ed25519
  # GitHub's SSH host keys from its published metadata, so the first clone meets no
  # prompt and trusts nothing on first use.
  - |
    sudo --user=dev --set-home python3 - <<'PY'
    import json, os, urllib.request
    meta = json.load(urllib.request.urlopen("https://api.github.com/meta", timeout=30))
    path = os.path.expanduser("~/.ssh/known_hosts")
    with open(path, "a") as f:
        for key in meta["ssh_keys"]:
            f.write("github.com %s\n" % key)
    os.chmod(path, 0o600)
    PY
  - chmod 700 /home/dev/.ssh
  - chown --recursive dev:dev /home/dev/.ssh /home/dev/.claude
  # Git identity for commits made inside the VM, taken from the host's git config by make-seed.sh.
  - sudo --user=dev --set-home git config --global user.name "@@GIT_USER_NAME@@"
  - sudo --user=dev --set-home git config --global user.email "@@GIT_USER_EMAIL@@"
  - sudo --user=dev --set-home git config --global init.defaultBranch main
  # Pick up the sshd hardening written above.
  - systemctl restart ssh
  # Claude Code, native installer (optional; remove if not wanted in the image).
  # The installer is a bash script; piping it into sh (dash) fails with a syntax error.
  - sudo --user=dev --set-home bash -c 'curl --fail --silent --show-error --location https://claude.ai/install.sh | bash' || true
  # uv (Python projects and interpreters) and mise (per-project node, rust, terraform
  # and the rest, from each repository's .mise.toml), both into ~/.local/bin, then
  # their shell hooks for the IDE terminal, which runs an interactive bash.
  - sudo --user=dev --set-home sh -c 'curl --fail --silent --show-error --location https://astral.sh/uv/install.sh | sh' || true
  - sudo --user=dev --set-home sh -c 'curl --fail --silent --show-error --location https://mise.run | sh' || true
  - sudo --user=dev --set-home sh -c 'printf "\n# Tool versions per project (.mise.toml) and per-directory environments (.envrc)\neval \"\$(~/.local/bin/mise activate bash)\"\neval \"\$(direnv hook bash)\"\n" >> ~/.bashrc'
  - |
    { echo "== backend deploy key (add to the test repository):"; cat /home/dev/.ssh/deploy_ed25519.pub; } | tee /dev/console

final_message: "backend: cloud-init finished after $UPTIME seconds"
