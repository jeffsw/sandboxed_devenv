#cloud-config
# backend: plays a per-project VM in the rehearsal (ide_sandboxing_summary.md, 4.9).
# IDE backend pre-installed and registered, a dev user that only gw's key can
# reach, and a deploy key generated here so it never exists anywhere else.
# make-seed.sh fills the placeholder fields. On the Framework the same file, minus
# the static address, becomes the Incus base image's cloud-init.

hostname: backend
manage_etc_hosts: true
package_update: true

# GitHub's own apt repository for gh, so the backend gets current releases rather
# than the archive's. cloud-init writes the key to its own keyring file and
# substitutes $KEY_FILE. The key block is GitHub's published keyring, exported
# armored on 9 October 2026: it holds the 2022 signing key (expired 5 September
# 2026) and the 2026 key that signs the repository today. Refresh it from
# https://cli.github.com/packages/githubcli-archive-keyring.gpg when GitHub
# rotates again (apt then reports a NO_PUBKEY error for cli.github.com).
apt:
  sources:
    github-cli:
      source: "deb [signed-by=$KEY_FILE] https://cli.github.com/packages stable main"
