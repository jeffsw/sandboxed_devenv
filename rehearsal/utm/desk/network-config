version: 2
# Render through systemd-networkd on both VMs. On desk the desktop install adds
# NetworkManager and makes it netplan's default renderer; then the dracut
# initramfs's catch-all DHCP rule in /run/systemd/network wins the NIC first and
# NetworkManager never applies the static profile (seen 9 October 2026). With
# networkd, netplan's 10-netplan-enp0s1.network sorts ahead of that rule.
renderer: networkd
ethernets:
  # Exact name of UTM's Apple-backend virtio NIC. A glob such as "en*" works under
  # systemd-networkd but not under NetworkManager, which the desktop pulls in on desk.
  enp0s1:
    dhcp4: false
    addresses: [192.168.64.10/24]
    routes:
      - to: default
        via: 192.168.64.1
      # UTM's shared network marks each VM's port on the Mac's bridge "private", so
      # the VMs cannot reach each other directly; the Mac forwards between them.
      - to: 192.168.64.20/32
        via: 192.168.64.1
    nameservers:
      addresses: [192.168.64.1]
