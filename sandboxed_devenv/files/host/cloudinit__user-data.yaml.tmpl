#cloud-config
# sandboxed-devenv host: cloud-init user-data for the desk VM on the Mac rig (summary, 4.9)
# First boot installs the desktop and the packages `host install` expects, and creates the
# host user with the rig key. Everything else (the gw user, the files, AppArmor, nftables,
# the Gateway launcher) is `sudo sandboxed-devenv host install`, which `client-host new` runs
# over SSH once cloud-init is done: the same two commands as the Linux laptop's install day,
# after `sudo pipx install --global` of the wheel.

hostname: desk
manage_etc_hosts: true
package_update: true
packages:
  - ubuntu-desktop-minimal
  # Clipboard sharing with the Mac over UTM's SPICE agent port (create-vms.sh turns it on).
  - spice-vdagent
  # `sudo pipx install --global WHEEL` puts the package under /opt/pipx and the command in
  # /usr/local/bin, inside sudo's secure_path, readable by every user.
  - pipx
  # What `host install` needs; installed here so the first boot is one apt run.
  - acl
  - nftables
  - wl-clipboard
  - xwayland-run
  - xauth

users:
  # Plays "you" on the host: logs in to GNOME, runs `sandboxed-devenv client start`. Has sudo.
  - name: @@CLIENT_HOST_USER@@
    gecos: Host user
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: "@@DESK_PASSWORD@@"
    # The control key, kept on the Mac in ~/.sandboxed_devenv/secrets/, so the Mac can SSH in.
    # Not the sandbox key: gw's key must open backends, never the host user.
    ssh_authorized_keys:
      - @@CONTROL_PUBKEY@@

# The VM's SSH host key, minted by the control side into this seed so its public half is pinned
# on the control side and the client host before the VM boots: no trust on first use. Only the
# ed25519 key exists (ssh_genkeytypes), so nothing unpinned answers.
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
ssh_keys:
  ed25519_private: |
@@HOST_KEY_PRIVATE@@
  ed25519_public: @@HOST_KEY_PUBLIC@@

runcmd:
  # Boot into GDM from now on. No reboot here: `client-host new` reboots once `host install`
  # is done, so there is no race between the reboot and its SSH session.
  - systemctl set-default graphical.target

final_message: "desk: cloud-init finished after $UPTIME seconds; client-host new does the rest"
