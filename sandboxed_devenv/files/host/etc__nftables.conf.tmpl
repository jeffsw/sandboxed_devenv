#!/usr/sbin/nft -f
# sandboxed-devenv host: rendered to /etc/nftables.conf
# The egress policy from policy.yaml in two halves. The backend half forwards and masquerades
# the VMs' traffic to the allowlist only (summary, 4.9 step 7); the client half limits what the
# client sandbox user may reach: the VM subnet, the resolver, and the client allowlist. `host
# install` writes the file and enables the service only when the policy says `enforce`. Only
# CIDRs are here: nft refuses a host name that resolves to several addresses (8 November 2026),
# so the hosts each side needs are listed as comments until M5 settles how names are followed.
#   client hosts:  @@CLIENT_HOSTS@@
#   backend hosts: @@BACKEND_HOSTS@@
flush ruleset

define vm_subnet = @@VM_SUBNET@@
define uplink = "@@UPLINK_INTERFACE@@"
# The uid of @@SANDBOX_USER@@, the client sandbox user; a name would be resolved when the
# rules are parsed, which fails wherever the user does not exist (CI).
define sandbox_uid = @@SANDBOX_UID@@

table inet vmrouter {
  set backend_allowed {
    type ipv4_addr
    flags interval
    @@BACKEND_ALLOWED@@
  }
  set client_allowed {
    type ipv4_addr
    flags interval
    @@CLIENT_ALLOWED@@
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ip saddr $vm_subnet ip daddr @backend_allowed tcp dport @@BACKEND_PORTS@@ accept
    ip saddr $vm_subnet log prefix "vmrouter drop: " drop
  }
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid != $sandbox_uid accept
    ct state established,related accept
    ip daddr $vm_subnet accept
    udp dport 53 accept
    tcp dport 53 accept
    ip daddr @client_allowed tcp dport @@CLIENT_PORTS@@ accept
    log prefix "client drop: " drop
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr $vm_subnet oifname $uplink masquerade
  }
}
