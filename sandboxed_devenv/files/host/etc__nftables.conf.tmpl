#!/usr/sbin/nft -f
# sandboxed-devenv host: rendered to /etc/nftables.conf
# Egress allowlist for the backend VMs (summary, 4.9 step 7). `host install` writes it and
# leaves the service disabled; policy decides when `systemctl enable --now nftables` runs.
# The same table serves the Linux laptop; only the uplink interface name changes.
flush ruleset

define backends = { @@BACKEND_ADDRESS@@ }
define uplink = "@@UPLINK_INTERFACE@@"
# The four github.com "git" ranges from https://api.github.com/meta (read 8 October 2026);
# the API also lists per-region /32 hosts, add them if GitHub stops answering.
define github_v4 = { 140.82.112.0/20, 143.55.64.0/20, 185.199.108.0/22, 192.30.252.0/22 }

table inet vmrouter {
  set allowed {
    type ipv4_addr
    flags interval
    elements = $github_v4
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ip saddr $backends ip daddr @allowed tcp dport { 22, 443 } accept
    ip saddr $backends log prefix "vmrouter drop: " drop
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr $backends oifname $uplink masquerade
  }
}
