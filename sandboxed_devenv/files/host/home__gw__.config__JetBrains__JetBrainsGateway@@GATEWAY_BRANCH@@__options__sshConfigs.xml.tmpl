<!-- sandboxed-devenv host: rendered to /home/gw/.config/JetBrains/JetBrainsGateway@@GATEWAY_BRANCH@@/options/sshConfigs.xml -->
<!-- The SSH connection to the backend, exactly as Gateway 2026.2 wrote it after the first
     connection was made in its window (9 October 2026), so a fresh client host starts with
     the connection present. The key path uses Gateway's own macro. -->
<application>
  <component name="SshConfigs">
    <configs>
      <sshConfig host="@@BACKEND_ADDRESS@@" id="8c05b60b-188a-439b-861b-899cbb9fda27" keyPath="$USER_HOME$/.ssh/vm_ed25519" port="22" nameFormat="DESCRIPTIVE" username="dev" useOpenSSHConfig="true" />
    </configs>
  </component>
</application>
